<smile version="1.0" id="Network4" numsamples="10000" discsamples="10000">
	<nodes>
		<cpt id="Test">
			<state id="notest" />
			<state id="test" />
			<probabilities>0.5 0.5</probabilities>
		</cpt>
		<cpt id="Weather">
			<state id="Sunshine" />
			<state id="Rain" />
			<probabilities>0.4 0.6</probabilities>
		</cpt>
		<cpt id="Detector">
			<state id="SaySun" />
			<state id="SayRain" />
			<parents>Weather Test</parents>
			<probabilities>0.5 0.5 0.8 0.2 0.5 0.5 0.2 0.8</probabilities>
		</cpt>
		<decision id="Party_location">
			<state id="Outdoors" />
			<state id="Porch" />
			<state id="Indoors" />
			<parents>Test Detector</parents>
		</decision>
		<utility id="values">
			<parents>Weather Party_location</parents>
			<utilities>100 90 40 0 20 50</utilities>
		</utility>
	</nodes>
	<extensions>
